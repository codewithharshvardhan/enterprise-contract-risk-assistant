# ─── Dev server ─────────────────────────────────────────────────────────────────
PORT=5173

# ─── Backend targets — used by the Vite dev proxy only (never sent to browser) ──
# /proxy/service1/* forwards to BACKEND_1_URL (strip prefix before forwarding)
# /proxy/service2/* forwards to BACKEND_2_URL (strip prefix before forwarding)
BACKEND_1_URL=http://localhost:8000
BACKEND_2_URL=http://localhost:4000

# ─── Production direct URLs — only needed when there is no reverse proxy ─────────
# Populated at build time: VITE_PROD_BACKEND_1_URL=https://api.example.com npm run build
VITE_PROD_BACKEND_1_URL=
VITE_PROD_BACKEND_2_URL=
