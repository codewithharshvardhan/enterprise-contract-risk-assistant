PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
NODE_ENV=development

# OpenRouter API key (https://openrouter.ai/keys). Used by services/openai.ts for
# nodes 3-5 (Extractor, Risk Evaluator, JSON Guardrail Formatter). Get your own key —
# none is provided as part of this assignment.
OPENROUTER_API_KEY=

# Model id to use for all three LLM-backed nodes. OpenRouter's free-tier lineup
# changes over time — verify current availability at https://openrouter.ai/models
# before relying on a specific model id.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
